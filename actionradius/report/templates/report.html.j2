<!DOCTYPE html>
<html>
<head>
<style>
body { font-family: -apple-system, sans-serif; background: #0d1117; color: #c9d1d9; margin: 0; padding: 20px; }
.card { background: #161b22; border: 1px solid #30363d; border-radius: 6px; padding: 16px; margin-bottom: 16px; }
.critical { border-left: 4px solid #da3633; }
.high { border-left: 4px solid #d29922; }
.medium { border-left: 4px solid #d29922; }
.low { border-left: 4px solid #238636; }
.info { border-left: 4px solid #388bfd; }
.badge { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 12px; font-weight: bold; }
.badge-critical { background: #da3633; color: white; }
.badge-unknown { background: #d29922; color: white; }
.badge-safe { background: #238636; color: white; }
.detail { font-size: 13px; color: #8b949e; margin: 4px 0; }
</style>
</head>
<body>
<h1>ActionRadius Triage Report: {{ target }}</h1>

<h2>🚨 Currently Compromised ({{ compromised_findings|length }})</h2>
{% for f in compromised_findings %}
<div class="card {{ f.severity }}">
  <h3><span class="badge badge-critical">{{ f.severity | upper }} — COMPROMISED</span> {{ f.repo.owner }}/{{ f.repo.name }} : {{ f.uses_site.workflow_path }}</h3>
  <p><strong>Action:</strong> {{ f.uses_site.uses.raw }}</p>
  <p><strong>Resolved SHA:</strong> <code>{{ f.resolved.current_sha or "unresolved" }}</code></p>
  <p class="detail"><strong>Pin type:</strong> {{ f.pin_type }} | <strong>Historical exposure:</strong> {{ f.historical_exposure }}</p>
  <p class="detail"><strong>Publisher trust:</strong> {{ f.publisher_trust }}</p>
  <p><strong>Rationale:</strong> {{ f.rationale }}</p>
</div>
{% else %}
<p>No currently compromised sites found. ✅</p>
{% endfor %}

<h2>⚠️ Unknown Status ({{ unknown_findings|length }})</h2>
{% for f in unknown_findings %}
<div class="card medium">
  <h3><span class="badge badge-unknown">{{ f.severity | upper }} — UNKNOWN</span> {{ f.repo.owner }}/{{ f.repo.name }} : {{ f.uses_site.workflow_path }}</h3>
  <p><strong>Action:</strong> {{ f.uses_site.uses.raw }}</p>
  <p><strong>Resolved SHA:</strong> <code>{{ f.resolved.current_sha or "unresolved" }}</code></p>
  <p class="detail"><strong>Pin type:</strong> {{ f.pin_type }} | <strong>Historical exposure:</strong> {{ f.historical_exposure }}</p>
  <p class="detail"><strong>Publisher trust:</strong> {{ f.publisher_trust }}</p>
  <p><strong>Rationale:</strong> {{ f.rationale }}</p>
</div>
{% else %}
<p>No findings with unknown status.</p>
{% endfor %}

<h2>✅ Safe ({{ safe_findings|length }})</h2>
{% for f in safe_findings %}
<div class="card info">
  <h3><span class="badge badge-safe">SAFE</span> {{ f.repo.owner }}/{{ f.repo.name }} : {{ f.uses_site.workflow_path }}</h3>
  <p><strong>Action:</strong> {{ f.uses_site.uses.raw }}</p>
  <p><strong>Resolved SHA:</strong> <code>{{ f.resolved.current_sha or "unresolved" }}</code></p>
  <p class="detail"><strong>Pin type:</strong> {{ f.pin_type }}</p>
  <p class="detail"><strong>Publisher trust:</strong> {{ f.publisher_trust }}</p>
</div>
{% else %}
<p>No safe sites found.</p>
{% endfor %}

</body>
</html>
